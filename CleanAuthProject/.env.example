# Configuração de produção para integração GLPI
# Copie este arquivo para `.env` e preencha com valores reais

GLPI_URL=https://SEU_GLPI/apirest.php
GLPI_APP_TOKEN=SEU_APP_TOKEN
GLPI_USER_TOKEN=SEU_USER_TOKEN

# Opcional (quando autenticar por login/senha ao invés de user token)
# GLPI_LOGIN=seu_login
# GLPI_PASSWORD=sua_senha
# GLPI_TOTP_SECRET=seu_segredo_totp