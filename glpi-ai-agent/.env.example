# GLPI Configuration (DTIC)
GLPI_DTIC_URL=http://your-glpi-url/apirest.php
GLPI_DTIC_APP_TOKEN=your_app_token
GLPI_DTIC_USER_TOKEN=your_user_token

# GLPI Configuration (SIS)
GLPI_SIS_URL=http://your-glpi-url/apirest.php
GLPI_SIS_APP_TOKEN=your_app_token
GLPI_SIS_USER_TOKEN=your_user_token

# AI Configuration
AI_SERVICE_URL=http://host.docker.internal:11434/api/generate
AI_MODEL_NAME=llama3
AI_CONFIDENCE_THRESHOLD=0.85

# Worker Configuration
POLLING_INTERVAL=60
LOG_LEVEL=INFO

# Category Cache Configuration
CATEGORY_CACHE_TTL_SECONDS=300  # Cache TTL in seconds (default: 5 minutes)
