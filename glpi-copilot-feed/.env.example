# --- Credenciais do Banco de Dados (PostgreSQL) ---
# Onde está o banco glpi_data?
PGHOST=localhost
PGPORT=5432
PGDATABASE=glpi_data
PGUSER=user
PGPASSWORD=password

# --- Configuração do Job ---
# Defina como "true" apenas se tiver configurado as credenciais abaixo
ENABLE_SHAREPOINT_UPLOAD=false

# --- Credenciais do Microsoft 365 (Azure AD / Entra ID) ---
# (Opcional - Apenas se ENABLE_SHAREPOINT_UPLOAD=true)
# Necessário registrar um App no Azure Portal (App Registrations)
# Permissões necessárias (Application): Files.ReadWrite.All, Sites.Read.All

# ID do Diretório (Tenant ID)
AZURE_TENANT_ID=seu-tenant-id-aqui

# ID do Aplicativo (Client ID)
AZURE_CLIENT_ID=seu-client-id-aqui

# Segredo do Cliente (Client Secret) - Gerado em "Certificates & secrets"
AZURE_CLIENT_SECRET=seu-client-secret-aqui

# --- Destino no SharePoint ---
# (Opcional - Apenas se ENABLE_SHAREPOINT_UPLOAD=true)
# Para obter esses IDs, você pode usar o Graph Explorer (https://developer.microsoft.com/en-us/graph/graph-explorer)

# ID do Site SharePoint onde os arquivos serão salvos
# GET https://graph.microsoft.com/v1.0/sites/{hostname}:/sites/{site-path}?$select=id
SP_SITE_ID=seu-site-id-aqui

# ID da Biblioteca de Documentos (Drive) dentro do Site
# GET https://graph.microsoft.com/v1.0/sites/{site-id}/drives
SP_DRIVE_ID=seu-drive-id-aqui

# (Opcional) Caminho da pasta dentro da biblioteca. Deixe em branco para raiz.
# Exemplo: /Dados/GLPI
SP_FOLDER_PATH=
