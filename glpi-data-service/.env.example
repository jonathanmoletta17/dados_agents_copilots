# ==============================================
# PostgreSQL Configuration
# ==============================================
POSTGRES_PASSWORD=glpi_secure_password_2024
POSTGRES_USER=glpi_user
POSTGRES_DB=glpi_data

# ==============================================
# pgAdmin Configuration
# ==============================================
PGADMIN_EMAIL=admin@localhost.com
PGADMIN_PASSWORD=admin

# ==============================================
# GLPI API Configuration
# ==============================================
# IMPORTANTE: Este serviço suporta múltiplos GLPIs simultaneamente
# Cada GLPI é identificado por um "contexto" (ex: DTIC, SIS)
# Use o prefixo GLPI_<CONTEXTO>_ para cada conjunto de credenciais

# -------------------- CONTEXTO: DTIC --------------------
# Configurações para o GLPI da DTIC
GLPI_DTIC_URL=http://cau.ppiratini.intra.rs.gov.br/glpi/apirest.php
GLPI_DTIC_APP_TOKEN=
GLPI_DTIC_USER_TOKEN=

# -------------------- CONTEXTO: SIS --------------------
# Configurações para o GLPI da SIS (Manutenção)
GLPI_SIS_URL=http://cau.ppiratini.intra.rs.gov.br/sis/apirest.php
GLPI_SIS_APP_TOKEN=
GLPI_SIS_USER_TOKEN=

# ==============================================
# Sync Worker Configuration
# ==============================================
SYNC_INTERVAL=15
SYNC_FULL_DAYS_LOOKBACK=365

# ==============================================
# Application Configuration
# ==============================================
LOG_LEVEL=INFO
TZ=America/Sao_Paulo